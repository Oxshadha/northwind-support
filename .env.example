# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section". Setting this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json - useful if you run SQL Server elsewhere,
# or on another port.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Development turns on Swagger, the automatic migration and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# --- Sign-in ---------------------------------------------------------------
# The key that signs access tokens (HMAC-SHA256, at least 32 bytes), for the API
# run with `npm run api`. Development has a "dev-only-" key in
# appsettings.Development.json; any other environment refuses to start with it,
# so set a real one, e.g. from: openssl rand -base64 48
# Jwt__SigningKey=

# --- API container (docker compose up) -------------------------------------
# docker-compose.yml passes these to the api service at run time; nothing is
# baked into the image. Every one has a local default.
#
# ASPNETCORE_ENVIRONMENT inside the container. Development turns on Swagger.
# API_ENVIRONMENT=Development
#
# The token signing key. Required outside Development, where the dev-only
# default is refused.
# JWT_SIGNING_KEY=
#
# Apply migrations and seed demo data on start-up (for an empty local volume).
# API_MIGRATE_AND_SEED=true
